library(dplyr)
library(scales)
calc_N <- function(pA, pB, alpha, puissance) {
  pbar <- (pA + pB) / 2
  za   <- qnorm(1 - alpha)
  zb   <- qnorm(puissance)
  num  <- 2*(za * sqrt(2 * pbar * (1 - pbar)) + zb * sqrt(pA*(1-pA) + pB*(1-pB)))^2
  den  <- (pA - pB)^2
  N   <- ceiling(num / den)
  if (N%%2==0){N=N}else{N=N+1}
  return (N)
}
# Calcul de la taille d'échantillon pour pA = 0.3, pB = 0.4, alpha = 0.05, puissance = 0.8
calc_N(pA = 0.3, pB = 0.4, alpha = 0.05, puissance = 0.8)

