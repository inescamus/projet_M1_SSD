# Variation de la puissance et d'alpha
# Paramètres fixes
pB      <- 0.30       # proportion dans le groupe témoin
delta   <- 0.20       # différence pA - pB (effet à détecter)
pA      <- pB + delta # pA = 0.50

# Grille des puissances (abscisse)
puissances <- seq(0.50, 0.95, by = 0.01)

# Différentes valeurs de alpha (chaque courbe)
alphas <- c(0.01, 0.05, 0.10)
couleurs <- c("#66CCEE", "#AA3377", "#4477AA")   # couleurs pour les courbes


# Calcul des N pour chaque alpha et chaque puissance
# Création d'une matrice : lignes = puissances, colonnes = alphas
N_matrix <- sapply(alphas, function(alpha) {
